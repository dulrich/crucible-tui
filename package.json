{
  "name": "mdview",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "bun test tests",
    "build": "bun build --compile --outfile dist/mdview src/cli.ts",
    "install:man": "mkdir -p \"$HOME/.local/share/man/man1\" && ln -sf \"$PWD/man/crucible-tui.1\" \"$HOME/.local/share/man/man1/mdview.1\" && ln -sf \"$PWD/man/crucible-tui.1\" \"$HOME/.local/share/man/man1/crucible-tui.1\"",
    "sweep": "bun run scripts/sweep.ts",
    "gen-licenses": "bun run scripts/gen-licenses.ts",
    "test:security": "trivy fs --scanners vuln --skip-db-update --exit-code 1 --severity CRITICAL,HIGH .",
    "verify": "bun run scripts/verify.ts"
  },
  "dependencies": {
    "highlight.js": "10.7.3",
    "marked": "14.1.4",
    "node-emoji": "2.2.0",
    "string-width": "7.2.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.3.14",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jiti": "^2.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
